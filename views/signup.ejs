<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.2/dist/tailwind.min.css" rel="stylesheet">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Sigup</title>
</head>
<body>
    <div class="grid grid-cols-6">
        <div class="col-start-3 col-span-2 space-y-3">
            <header> <%- include("header.ejs") %> </header>
            <h6 class="py-4">Signup as a new user</h6>
            <form action="/users" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="py-3">
                    <label for="firstName">First Name: </label>
                    <input type="text" name="firstName" id="firstName" class="border border-gray-300 text-gray-900 rounded p-2 w-full">
                </div>
                <div class="py-3">
                    <label for="lastName">Last Name: </label>
                    <input type="text" name="lastName" id="lastName" class="border border-gray-300 text-gray-900 rounded p-2 w-full">
                </div>
                <div class="py-3">
                    <label for="email">Email: </label>
                    <input type="email" name="email" id="email" class="border border-gray-300 text-gray-900 rounded p-2 w-full">
                </div>
                <div class="py-3">
                    <label for="password">Password: </label>
                    <input type="password" name="password" id="password" class="border border-gray-300 text-gray-900 rounded p-2 w-full">
                </div>
                <div class="py-3">
                    <button class="button text-white bg-green-600 hover:bg-green-800 font-medium rounded px-5 py-2" type="submit">Signup</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>